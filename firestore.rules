rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // GLOBAL HARDENED PRIMITIVES
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'nt6592147@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isBoundedUidList(arr) {
      return arr is list && arr.size() >= 1 && arr.size() <= 50 && arr[0] is string;
    }

    function isStringSized(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    function isNonEmptyString(val, maxLen) {
      return val is string && val.size() >= 1 && val.size() <= maxLen;
    }

    // Tenant / Master Gate Helpers (never called inside allow list!)
    function getFactory(factoryId) {
      return get(/databases/$(database)/documents/factories/$(factoryId)).data;
    }

    function factoryExists(factoryId) {
      return exists(/databases/$(database)/documents/factories/$(factoryId));
    }

    function isFactoryOwner(factoryId) {
      return isVerifiedUser() && factoryExists(factoryId) && getFactory(factoryId).ownerId == request.auth.uid;
    }

    function memberPath(factoryId, uid) {
      return /databases/$(database)/documents/factories/$(factoryId)/members/$(uid);
    }

    function isFactoryMember(factoryId) {
      return isVerifiedUser() && (
        isBootstrappedAdmin() ||
        isFactoryOwner(factoryId) ||
        (exists(memberPath(factoryId, request.auth.uid)) && get(memberPath(factoryId, request.auth.uid)).data.active == true)
      );
    }

    function getMemberRole(factoryId) {
      return exists(memberPath(factoryId, request.auth.uid))
        ? get(memberPath(factoryId, request.auth.uid)).data.role
        : (isBootstrappedAdmin() || isFactoryOwner(factoryId) ? 'super_admin' : 'none');
    }

    function isFactoryAdmin(factoryId) {
      return isVerifiedUser() && (
        isBootstrappedAdmin() ||
        isFactoryOwner(factoryId) ||
        (isFactoryMember(factoryId) && getMemberRole(factoryId) in ['super_admin', 'factory_admin'])
      );
    }

    function isManagementOrAdmin(factoryId) {
      return isFactoryAdmin(factoryId) || (
        isFactoryMember(factoryId) && getMemberRole(factoryId) in ['factory_manager', 'production_manager']
      );
    }

    function isValidRoleName(role) {
      return role in [
        'super_admin',
        'factory_admin',
        'factory_manager',
        'production_manager',
        'production_supervisor',
        'electrical_maintenance',
        'mechanical_maintenance',
        'material_checker',
        'storekeeper',
        'quality_control',
        'machine_operator'
      ];
    }

    function hasValidTenantEnvelope(data, factoryId) {
      return data.factoryId == factoryId
        && isNonEmptyString(data.factoryOwnerUid, 128)
        && isBoundedUidList(data.accessUids)
        && isNonEmptyString(data.createdByUid, 128)
        && data.recordOrigin in ['operational', 'sample'];
    }

    function hasValidListAccess(data) {
      return isVerifiedUser() && (
        isBootstrappedAdmin() ||
        data.factoryOwnerUid == request.auth.uid ||
        data.createdByUid == request.auth.uid ||
        (data.accessUids is list && request.auth.uid in data.accessUids)
      );
    }

    // Connection validation probe
    match /test/connection {
      allow get: if isSignedIn();
    }

    // =========================================================================
    // PII ISOLATED USER PROFILES
    // =========================================================================
    function isValidUserPrivateProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'defaultFactoryId', 'createdAt', 'updatedAt'])
        && data.uid == userId
        && isNonEmptyString(data.email, 200)
        && isNonEmptyString(data.displayName, 120)
        && (!('defaultFactoryId' in data) || isStringSized(data.defaultFactoryId, 128))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId}/private/info {
      allow get: if isVerifiedUser() && isValidId(userId) && (request.auth.uid == userId || isBootstrappedAdmin());
      allow list: if false;
      allow create: if isVerifiedUser() && isValidId(userId) && (request.auth.uid == userId || isBootstrappedAdmin())
        && isValidUserPrivateProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() && isValidId(userId) && (request.auth.uid == userId || isBootstrappedAdmin())
        && isValidUserPrivateProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'defaultFactoryId', 'email', 'updatedAt']);
      allow delete: if false;
    }

    // =========================================================================
    // FACTORY ROOT DOCUMENT
    // =========================================================================
    function isValidFactory(data, factoryId) {
      return data.keys().hasAll(['id', 'name', 'companyName', 'ownerId', 'accessUids', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'name', 'companyName', 'location', 'ownerId', 'accessUids',
          'departments', 'faultCategories', 'materialUnits', 'shifts', 'hasSampleData',
          'createdAt', 'updatedAt'
        ])
        && data.id == factoryId
        && isNonEmptyString(data.name, 160)
        && isNonEmptyString(data.companyName, 160)
        && (!('location' in data) || isStringSized(data.location, 160))
        && isNonEmptyString(data.ownerId, 128)
        && isBoundedUidList(data.accessUids)
        && (!('departments' in data) || (data.departments is list && data.departments.size() <= 30))
        && (!('faultCategories' in data) || (data.faultCategories is list && data.faultCategories.size() <= 40))
        && (!('materialUnits' in data) || (data.materialUnits is list && data.materialUnits.size() <= 20))
        && (!('shifts' in data) || (data.shifts is list && data.shifts.size() <= 10))
        && (!('hasSampleData' in data) || data.hasSampleData is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /factories/{factoryId} {
      allow get: if isVerifiedUser() && isValidId(factoryId) && isFactoryMember(factoryId);
      allow list: if isVerifiedUser() && (
        isBootstrappedAdmin() ||
        existing().ownerId == request.auth.uid ||
        (existing().accessUids is list && request.auth.uid in existing().accessUids)
      );
      allow create: if isVerifiedUser() && isValidId(factoryId)
        && isValidFactory(incoming(), factoryId)
        && incoming().ownerId == request.auth.uid
        && request.auth.uid in incoming().accessUids
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() && isValidId(factoryId)
        && isFactoryAdmin(factoryId)
        && isValidFactory(incoming(), factoryId)
        && incoming().id == existing().id
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'companyName', 'location', 'accessUids', 'departments',
          'faultCategories', 'materialUnits', 'shifts', 'hasSampleData', 'updatedAt'
        ]);
      allow delete: if false;

      // =======================================================================
      // FACTORY MEMBERS (RBAC DIRECTORY)
      // =======================================================================
      function isValidMember(data) {
        return data.keys().hasAll([
            'uid', 'factoryId', 'factoryOwnerUid', 'accessUids', 'displayName',
            'role', 'department', 'active', 'createdByUid', 'createdAt', 'updatedAt'
          ])
          && data.keys().hasOnly([
            'uid', 'factoryId', 'factoryOwnerUid', 'accessUids', 'displayName',
            'employeeCode', 'role', 'department', 'isMaintenanceHead', 'active',
            'createdByUid', 'createdAt', 'updatedAt'
          ])
          && data.factoryId == factoryId
          && isNonEmptyString(data.uid, 128)
          && isNonEmptyString(data.factoryOwnerUid, 128)
          && isBoundedUidList(data.accessUids)
          && isNonEmptyString(data.displayName, 120)
          && (!('employeeCode' in data) || isStringSized(data.employeeCode, 40))
          && isValidRoleName(data.role)
          && isNonEmptyString(data.department, 80)
          && (!('isMaintenanceHead' in data) || data.isMaintenanceHead is bool)
          && data.active is bool
          && isNonEmptyString(data.createdByUid, 128)
          && data.createdAt is timestamp
          && data.updatedAt is timestamp;
      }

      match /members/{memberUid} {
        allow get: if isVerifiedUser() && isValidId(memberUid) && isFactoryMember(factoryId);
        allow list: if hasValidListAccess(existing());
        allow create: if isVerifiedUser() && isValidId(memberUid)
          && isValidMember(incoming())
          && incoming().uid == memberUid
          && incoming().createdByUid == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && (
            isFactoryAdmin(factoryId) ||
            (isFactoryOwner(factoryId) && memberUid == request.auth.uid)
          );
        allow update: if isVerifiedUser() && isValidId(memberUid)
          && isFactoryAdmin(factoryId)
          && isValidMember(incoming())
          && incoming().uid == existing().uid
          && incoming().factoryId == existing().factoryId
          && incoming().factoryOwnerUid == existing().factoryOwnerUid
          && incoming().createdByUid == existing().createdByUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName', 'employeeCode', 'role', 'department',
            'isMaintenanceHead', 'active', 'accessUids', 'updatedAt'
          ]);
        allow delete: if false;
      }

      // =======================================================================
      // MATERIALS
      // =======================================================================
      function isValidMaterial(data) {
        return data.keys().hasAll([
            'factoryId', 'factoryOwnerUid', 'accessUids', 'materialCode', 'name',
            'category', 'batchNumber', 'quantity', 'remainingQty', 'unit',
            'status', 'recordOrigin', 'createdByUid', 'createdAt', 'updatedAt'
          ])
          && data.keys().hasOnly([
            'factoryId', 'factoryOwnerUid', 'accessUids', 'materialCode', 'name',
            'category', 'supplier', 'batchNumber', 'expectedWidthMm', 'expectedThicknessMm',
            'expectedWeightKg', 'quantity', 'remainingQty', 'consumedQty', 'wastedQty',
            'minThreshold', 'unit', 'dateReceived', 'storageLocation', 'status',
            'notes', 'recordOrigin', 'createdByUid', 'createdAt', 'updatedAt'
          ])
          && hasValidTenantEnvelope(data, factoryId)
          && isNonEmptyString(data.materialCode, 64)
          && isNonEmptyString(data.name, 160)
          && isNonEmptyString(data.category, 80)
          && (!('supplier' in data) || isStringSized(data.supplier, 160))
          && isNonEmptyString(data.batchNumber, 80)
          && (!('expectedWidthMm' in data) || data.expectedWidthMm is number)
          && (!('expectedThicknessMm' in data) || data.expectedThicknessMm is number)
          && (!('expectedWeightKg' in data) || data.expectedWeightKg is number)
          && data.quantity is number && data.quantity >= 0
          && data.remainingQty is number && data.remainingQty >= 0
          && (!('consumedQty' in data) || (data.consumedQty is number && data.consumedQty >= 0))
          && (!('wastedQty' in data) || (data.wastedQty is number && data.wastedQty >= 0))
          && (!('minThreshold' in data) || (data.minThreshold is number && data.minThreshold >= 0))
          && isNonEmptyString(data.unit, 32)
          && (!('dateReceived' in data) || isStringSized(data.dateReceived, 32))
          && (!('storageLocation' in data) || isStringSized(data.storageLocation, 120))
          && data.status in ['pending_inspection', 'approved', 'rejected', 'in_production', 'depleted', 'archived']
          && (!('notes' in data) || isStringSized(data.notes, 1000))
          && data.createdAt is timestamp
          && data.updatedAt is timestamp;
      }

      match /materials/{materialId} {
        allow get: if isVerifiedUser() && isValidId(materialId) && isFactoryMember(factoryId);
        allow list: if hasValidListAccess(existing());
        allow create: if isVerifiedUser() && isValidId(materialId)
          && isFactoryMember(factoryId)
          && getMemberRole(factoryId) in ['super_admin', 'factory_admin', 'factory_manager', 'production_manager', 'material_checker', 'storekeeper']
          && isValidMaterial(incoming())
          && incoming().createdByUid == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isVerifiedUser() && isValidId(materialId)
          && isFactoryMember(factoryId)
          && getMemberRole(factoryId) in ['super_admin', 'factory_admin', 'factory_manager', 'production_manager', 'production_supervisor', 'material_checker', 'storekeeper']
          && isValidMaterial(incoming())
          && incoming().factoryId == existing().factoryId
          && incoming().factoryOwnerUid == existing().factoryOwnerUid
          && incoming().createdByUid == existing().createdByUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'remainingQty', 'consumedQty', 'wastedQty', 'status', 'storageLocation', 'notes', 'minThreshold', 'updatedAt'
          ]);
        allow delete: if false;
      }

      // =======================================================================
      // MATERIAL INSPECTIONS
      // =======================================================================
      function isValidMaterialInspection(data) {
        return data.keys().hasAll([
            'factoryId', 'factoryOwnerUid', 'accessUids', 'materialId', 'materialCode',
            'batchNumber', 'actualWidthMm', 'actualThicknessMm', 'actualWeightKg',
            'inspectionDate', 'inspectorName', 'result', 'recordOrigin', 'createdByUid', 'createdAt', 'updatedAt'
          ])
          && data.keys().hasOnly([
            'factoryId', 'factoryOwnerUid', 'accessUids', 'materialId', 'materialCode',
            'materialName', 'batchNumber', 'expectedWidthMm', 'actualWidthMm',
            'expectedThicknessMm', 'actualThicknessMm', 'expectedWeightKg', 'actualWeightKg',
            'inspectionDate', 'inspectorName', 'result', 'comments', 'recordOrigin',
            'createdByUid', 'createdAt', 'updatedAt'
          ])
          && hasValidTenantEnvelope(data, factoryId)
          && isNonEmptyString(data.materialId, 128)
          && isNonEmptyString(data.materialCode, 64)
          && (!('materialName' in data) || isStringSized(data.materialName, 160))
          && isNonEmptyString(data.batchNumber, 80)
          && (!('expectedWidthMm' in data) || data.expectedWidthMm is number)
          && data.actualWidthMm is number
          && (!('expectedThicknessMm' in data) || data.expectedThicknessMm is number)
          && data.actualThicknessMm is number
          && (!('expectedWeightKg' in data) || data.expectedWeightKg is number)
          && data.actualWeightKg is number
          && isNonEmptyString(data.inspectionDate, 32)
          && isNonEmptyString(data.inspectorName, 120)
          && data.result in ['approved', 'rejected', 'conditional']
          && (!('comments' in data) || isStringSized(data.comments, 1000))
          && data.createdAt is timestamp
          && data.updatedAt is timestamp;
      }

      match /materialInspections/{inspectionId} {
        allow get: if isVerifiedUser() && isValidId(inspectionId) && isFactoryMember(factoryId);
        allow list: if hasValidListAccess(existing());
        allow create: if isVerifiedUser() && isValidId(inspectionId)
          && isFactoryMember(factoryId)
          && getMemberRole(factoryId) in ['super_admin', 'factory_admin', 'factory_manager', 'material_checker', 'quality_control', 'storekeeper']
          && isValidMaterialInspection(incoming())
          && incoming().createdByUid == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if false;
        allow delete: if false;
      }

      // =======================================================================
      // MATERIAL MOVEMENTS
      // =======================================================================
      function isValidMaterialMovement(data) {
        return data.keys().hasAll([
            'factoryId', 'factoryOwnerUid', 'accessUids', 'materialId', 'movementType',
            'quantity', 'unit', 'movementDate', 'recordOrigin', 'createdByUid', 'createdAt', 'updatedAt'
          ])
          && data.keys().hasOnly([
            'factoryId', 'factoryOwnerUid', 'accessUids', 'materialId', 'materialCode',
            'materialName', 'batchNumber', 'movementType', 'quantity', 'unit',
            'productionLine', 'recordedByName', 'movementDate', 'notes', 'recordOrigin',
            'createdByUid', 'createdAt', 'updatedAt'
          ])
          && hasValidTenantEnvelope(data, factoryId)
          && isNonEmptyString(data.materialId, 128)
          && (!('materialCode' in data) || isStringSized(data.materialCode, 64))
          && (!('materialName' in data) || isStringSized(data.materialName, 160))
          && (!('batchNumber' in data) || isStringSized(data.batchNumber, 80))
          && data.movementType in ['received', 'issued', 'consumed', 'wasted', 'returned']
          && data.quantity is number && data.quantity > 0
          && isNonEmptyString(data.unit, 32)
          && (!('productionLine' in data) || isStringSized(data.productionLine, 80))
          && (!('recordedByName' in data) || isStringSized(data.recordedByName, 120))
          && isNonEmptyString(data.movementDate, 32)
          && (!('notes' in data) || isStringSized(data.notes, 500))
          && data.createdAt is timestamp
          && data.updatedAt is timestamp;
      }

      match /materialMovements/{movementId} {
        allow get: if isVerifiedUser() && isValidId(movementId) && isFactoryMember(factoryId);
        allow list: if hasValidListAccess(existing());
        allow create: if isVerifiedUser() && isValidId(movementId)
          && isFactoryMember(factoryId)
          && getMemberRole(factoryId) in ['super_admin', 'factory_admin', 'factory_manager', 'production_manager', 'production_supervisor', 'material_checker', 'storekeeper']
          && isValidMaterialMovement(incoming())
          && incoming().createdByUid == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if false;
        allow delete: if false;
      }

      // =======================================================================
      // MACHINES
      // =======================================================================
      function isValidMachine(data) {
        return data.keys().hasAll([
            'factoryId', 'factoryOwnerUid', 'accessUids', 'machineCode', 'name',
            'category', 'department', 'status', 'recordOrigin', 'createdByUid', 'createdAt', 'updatedAt'
          ])
          && data.keys().hasOnly([
            'factoryId', 'factoryOwnerUid', 'accessUids', 'machineCode', 'name',
            'category', 'equipmentGroup', 'manufacturer', 'model', 'serialNumber',
            'department', 'productionLine', 'installationDate', 'status',
            'runningHours', 'lastMaintenanceDate', 'nextMaintenanceDate', 'recordOrigin',
            'createdByUid', 'createdAt', 'updatedAt'
          ])
          && hasValidTenantEnvelope(data, factoryId)
          && isNonEmptyString(data.machineCode, 64)
          && isNonEmptyString(data.name, 160)
          && isNonEmptyString(data.category, 80)
          && (!('equipmentGroup' in data) || data.equipmentGroup in ['diaper_production', 'supporting_equipment'])
          && (!('manufacturer' in data) || isStringSized(data.manufacturer, 120))
          && (!('model' in data) || isStringSized(data.model, 120))
          && (!('serialNumber' in data) || isStringSized(data.serialNumber, 120))
          && isNonEmptyString(data.department, 80)
          && (!('productionLine' in data) || isStringSized(data.productionLine, 80))
          && (!('installationDate' in data) || isStringSized(data.installationDate, 32))
          && data.status in ['running', 'stopped', 'maintenance', 'standby', 'archived']
          && (!('runningHours' in data) || (data.runningHours is number && data.runningHours >= 0))
          && (!('lastMaintenanceDate' in data) || isStringSized(data.lastMaintenanceDate, 32))
          && (!('nextMaintenanceDate' in data) || isStringSized(data.nextMaintenanceDate, 32))
          && data.createdAt is timestamp
          && data.updatedAt is timestamp;
      }

      match /machines/{machineId} {
        allow get: if isVerifiedUser() && isValidId(machineId) && isFactoryMember(factoryId);
        allow list: if hasValidListAccess(existing());
        allow create: if isVerifiedUser() && isValidId(machineId)
          && isFactoryAdmin(factoryId)
          && isValidMachine(incoming())
          && incoming().createdByUid == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isVerifiedUser() && isValidId(machineId)
          && isFactoryMember(factoryId)
          && isValidMachine(incoming())
          && incoming().factoryId == existing().factoryId
          && incoming().factoryOwnerUid == existing().factoryOwnerUid
          && incoming().createdByUid == existing().createdByUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isFactoryAdmin(factoryId) ||
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'runningHours', 'lastMaintenanceDate', 'nextMaintenanceDate', 'updatedAt'
            ])
          );
        allow delete: if false;
      }

      // =======================================================================
      // PRODUCTION RECORDS
      // =======================================================================
      function isValidProductionRecord(data) {
        return data.keys().hasAll([
            'factoryId', 'factoryOwnerUid', 'accessUids', 'productionDate', 'productName',
            'productionLine', 'machineName', 'shift', 'targetQty', 'actualQty', 'rejectedQty',
            'recordOrigin', 'createdByUid', 'createdAt', 'updatedAt'
          ])
          && data.keys().hasOnly([
            'factoryId', 'factoryOwnerUid', 'accessUids', 'productionDate', 'productName',
            'productionLine', 'machineId', 'machineName', 'shift', 'targetQty', 'actualQty',
            'rejectedQty', 'materialsConsumed', 'startTime', 'endTime', 'supervisorName',
            'operatorName', 'notes', 'recordOrigin', 'createdByUid', 'createdAt', 'updatedAt'
          ])
          && hasValidTenantEnvelope(data, factoryId)
          && isNonEmptyString(data.productionDate, 32)
          && isNonEmptyString(data.productName, 160)
          && isNonEmptyString(data.productionLine, 80)
          && (!('machineId' in data) || isStringSized(data.machineId, 128))
          && isNonEmptyString(data.machineName, 160)
          && isNonEmptyString(data.shift, 32)
          && data.targetQty is number && data.targetQty >= 0
          && data.actualQty is number && data.actualQty >= 0
          && data.rejectedQty is number && data.rejectedQty >= 0
          && (!('materialsConsumed' in data) || isStringSized(data.materialsConsumed, 500))
          && (!('startTime' in data) || isStringSized(data.startTime, 16))
          && (!('endTime' in data) || isStringSized(data.endTime, 16))
          && (!('supervisorName' in data) || isStringSized(data.supervisorName, 120))
          && (!('operatorName' in data) || isStringSized(data.operatorName, 120))
          && (!('notes' in data) || isStringSized(data.notes, 1000))
          && data.createdAt is timestamp
          && data.updatedAt is timestamp;
      }

      match /productionRecords/{recordId} {
        allow get: if isVerifiedUser() && isValidId(recordId) && isFactoryMember(factoryId);
        allow list: if hasValidListAccess(existing());
        allow create: if isVerifiedUser() && isValidId(recordId)
          && isFactoryMember(factoryId)
          && getMemberRole(factoryId) in ['super_admin', 'factory_admin', 'factory_manager', 'production_manager', 'production_supervisor', 'machine_operator']
          && isValidProductionRecord(incoming())
          && incoming().createdByUid == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isVerifiedUser() && isValidId(recordId)
          && isManagementOrAdmin(factoryId)
          && isValidProductionRecord(incoming())
          && incoming().factoryId == existing().factoryId
          && incoming().factoryOwnerUid == existing().factoryOwnerUid
          && incoming().createdByUid == existing().createdByUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'targetQty', 'actualQty', 'rejectedQty', 'materialsConsumed', 'notes', 'updatedAt'
          ]);
        allow delete: if false;
      }

      // =======================================================================
      // MACHINE INCIDENTS
      // =======================================================================
      function isValidIncident(data) {
        return data.keys().hasAll([
            'factoryId', 'factoryOwnerUid', 'accessUids', 'machineId', 'machineName',
            'department', 'faultCategory', 'description', 'reportedDate', 'reportedTime',
            'severity', 'status', 'recordOrigin', 'createdByUid', 'createdAt', 'updatedAt'
          ])
          && data.keys().hasOnly([
            'factoryId', 'factoryOwnerUid', 'accessUids', 'incidentCode', 'machineId',
            'machineCode', 'machineName', 'department', 'faultCategory', 'description',
            'alarmInfo', 'reportedDate', 'reportedTime', 'reportedByName', 'shift',
            'severity', 'status', 'recordOrigin', 'createdByUid', 'createdAt', 'updatedAt'
          ])
          && hasValidTenantEnvelope(data, factoryId)
          && (!('incidentCode' in data) || isStringSized(data.incidentCode, 64))
          && isNonEmptyString(data.machineId, 128)
          && (!('machineCode' in data) || isStringSized(data.machineCode, 64))
          && isNonEmptyString(data.machineName, 160)
          && data.department in ['electrical', 'mechanical', 'operational']
          && isNonEmptyString(data.faultCategory, 120)
          && isNonEmptyString(data.description, 1500)
          && (!('alarmInfo' in data) || isStringSized(data.alarmInfo, 240))
          && isNonEmptyString(data.reportedDate, 32)
          && isNonEmptyString(data.reportedTime, 16)
          && (!('reportedByName' in data) || isStringSized(data.reportedByName, 120))
          && (!('shift' in data) || isStringSized(data.shift, 32))
          && data.severity in ['low', 'medium', 'high', 'critical']
          && data.status in ['open', 'in_progress', 'resolved']
          && data.createdAt is timestamp
