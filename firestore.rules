          && (!('servicingHours' in data) || (data.servicingHours is number && data.servicingHours >= 0))
          && (!('observations' in data) || isStringSized(data.observations, 1000))
          && (!('handoverNotes' in data) || isStringSized(data.handoverNotes, 1000))
