          && data.keys().hasOnly([
            'factoryId', 'factoryOwnerUid', 'accessUids', 'department', 'reportType',
            'shift', 'reportDate', 'supervisorName', 'activitiesCompleted', 'productionSummary',
            'machineIssues', 'maintenanceActivities', 'outstandingProblems', 'unresolvedIncidentsCount',
            'materialsUsed', 'sparePartsUsed', 'totalDowntimeMinutes', 'runningHours',
            'servicingHours', 'observations', 'handoverNotes', 'status', 'reviewedByName',
            'recordOrigin', 'createdByUid', 'createdAt', 'updatedAt'
          ])
          && hasValidTenantEnvelope(data, factoryId)
          && isNonEmptyString(data.department, 80)
          && data.reportType in ['departmental', 'electrical_shift_end', 'mechanical_shift_end']
          && isNonEmptyString(data.shift, 32)
          && isNonEmptyString(data.reportDate, 32)
          && isNonEmptyString(data.supervisorName, 120)
