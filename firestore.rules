            'machineId', 'machineCode', 'machineName', 'incidentId', 'faultCategory',
            'faultDescription', 'actionTaken', 'sparePartsUsed', 'downtimeMinutes',
            'runningHours', 'servicingHours', 'technicianName', 'startTime',
            'completionTime', 'restorationTime', 'observations', 'shift', 'status',
            'recordOrigin', 'createdByUid', 'createdAt', 'updatedAt'
          ])
          && hasValidTenantEnvelope(data, factoryId)
          && data.discipline in ['electrical', 'mechanical']
          && isNonEmptyString(data.recordDate, 32)
          && isNonEmptyString(data.machineId, 128)
          && (!('machineCode' in data) || isStringSized(data.machineCode, 64))
          && isNonEmptyString(data.machineName, 160)
          && (!('incidentId' in data) || isStringSized(data.incidentId, 128))
          && (!('faultCategory' in data) || isStringSized(data.faultCategory, 120))
          && isNonEmptyString(data.faultDescription, 1500)
          && isNonEmptyString(data.actionTaken, 1500)
          && (!('sparePartsUsed' in data) || isStringSized(data.sparePartsUsed, 500))
          && data.downtimeMinutes is number && data.downtimeMinutes >= 0
          && (!('runningHours' in data) || (data.runningHours is number && data.runningHours >= 0))
          && (!('servicingHours' in data) || (data.servicingHours is number && data.servicingHours >= 0))
          && isNonEmptyString(data.technicianName, 120)
          && (!('startTime' in data) || isStringSized(data.startTime, 16))
          && (!('completionTime' in data) || isStringSized(data.completionTime, 16))
          && (!('restorationTime' in data) || isStringSized(data.restorationTime, 16))
          && (!('observations' in data) || isStringSized(data.observations, 1000))
          && (!('shift' in data) || isStringSized(data.shift, 32))
          && data.status in ['in_progress', 'completed', 'awaiting_review', 'approved']
          && data.createdAt is timestamp
          && data.updatedAt is timestamp;
