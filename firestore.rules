        allow update: if isVerifiedUser() && isValidId(notifId)
          && isFactoryMember(factoryId)
          && isValidNotification(incoming())
          && incoming().factoryId == existing().factoryId
          && incoming().factoryOwnerUid == existing().factoryOwnerUid
          && incoming().createdByUid == existing().createdByUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['isRead', 'updatedAt']);
        allow delete: if false;
      }

      // =======================================================================
      // IMMUTABLE AUDIT LOGS
      // =======================================================================
      function isValidAuditLog(data) {
        return data.keys().hasAll([
            'factoryId', 'factoryOwnerUid', 'accessUids', 'actorUid', 'actorName',
            'actorRole', 'action', 'entityType', 'entityId', 'createdByUid', 'createdAt'
          ])
          && data.keys().hasOnly([
            'factoryId', 'factoryOwnerUid', 'accessUids', 'actorUid', 'actorName',
            'actorRole', 'action', 'entityType', 'entityId', 'previousValue', 'newValue',
            'createdByUid', 'createdAt'
          ])
          && data.factoryId == factoryId
          && isNonEmptyString(data.factoryOwnerUid, 128)
          && isBoundedUidList(data.accessUids)
          && data.actorUid == request.auth.uid
          && isNonEmptyString(data.actorName, 120)
          && isNonEmptyString(data.actorRole, 64)
          && data.action in ['create', 'update', 'archive', 'review']
          && isNonEmptyString(data.entityType, 64)
          && isNonEmptyString(data.entityId, 128)
          && (!('previousValue' in data) || isStringSized(data.previousValue, 1000))
          && (!('newValue' in data) || isStringSized(data.newValue, 1000))
          && data.createdByUid == request.auth.uid
          && data.createdAt is timestamp;
      }

      match /auditLogs/{logId} {
        allow get: if isVerifiedUser() && isValidId(logId) && isFactoryMember(factoryId);
        allow list: if hasValidListAccess(existing());
        allow create: if isVerifiedUser() && isValidId(logId)
          && isFactoryMember(factoryId)
          && isValidAuditLog(incoming())
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if false;
      }
    }
  }
}
