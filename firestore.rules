      // =======================================================================
      function isValidShiftReport(data) {
        return data.keys().hasAll([
            'factoryId', 'factoryOwnerUid', 'accessUids', 'department', 'reportType',
            'shift', 'reportDate', 'supervisorName', 'activitiesCompleted', 'status',
            'recordOrigin', 'createdByUid', 'createdAt', 'updatedAt'
