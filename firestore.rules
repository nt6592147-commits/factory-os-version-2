          && (!('discipline' in data) || data.discipline in ['electrical', 'mechanical'])
          && isNonEmptyString(data.taskTitle, 200)
          && data.intervalType in ['daily', 'weekly', 'monthly', 'custom', 'running_hours']
          && (!('intervalValue' in data) || isStringSized(data.intervalValue, 64))
          && (!('assignedTechnician' in data) || isStringSized(data.assignedTechnician, 120))
          && (!('checklistSummary' in data) || isStringSized(data.checklistSummary, 1000))
          && (!('lastCompletedDate' in data) || isStringSized(data.lastCompletedDate, 32))
          && isNonEmptyString(data.nextDueDate, 32)
