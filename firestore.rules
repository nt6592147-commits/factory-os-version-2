      // =======================================================================
      // ELECTRICAL & MECHANICAL MAINTENANCE RECORDS
      // =======================================================================
      function isValidMaintenanceRecord(data) {
        return data.keys().hasAll([
            'factoryId', 'factoryOwnerUid', 'accessUids', 'discipline', 'recordDate',
            'machineId', 'machineName', 'faultDescription', 'actionTaken',
            'downtimeMinutes', 'technicianName', 'status', 'recordOrigin',
            'createdByUid', 'createdAt', 'updatedAt'
          ])
