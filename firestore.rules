      // =======================================================================
      // PREVENTIVE MAINTENANCE SCHEDULES
      // =======================================================================
      function isValidPreventiveSchedule(data) {
        return data.keys().hasAll([
            'factoryId', 'factoryOwnerUid', 'accessUids', 'machineId', 'machineName',
            'taskTitle', 'intervalType', 'nextDueDate', 'status', 'recordOrigin',
            'createdByUid', 'createdAt', 'updatedAt'
